# Статический деплой (например Timeweb Apps без Node): форма шлёт POST сразу в Google Apps Script.
# Обязательно для сборки/дев-сервера (префикс VITE_ — подставляется в клиентский бандл).
VITE_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# Опционально: если задано, в JSON уйдёт поле leadSecret (можно проверять в Apps Script через свойства скрипта).
# VITE_LEADS_SECRET=your-demo-secret

# Опционально: если поднимаете Node (server.mjs) или serverless /api/lead
LEADS_WEBHOOK_URL=
LEADS_FALLBACK_WEBHOOK_URL=
